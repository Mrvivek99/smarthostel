# Base URL of the Next.js backend (no trailing slash). Leave empty in dev to use the Vite proxy.
VITE_API_URL=http://localhost:3000
# Dev only: where the Vite proxy forwards /api when VITE_API_URL is empty
VITE_PROXY_TARGET=http://localhost:3000
# Single shared login page (the Next.js app's /login). Defaults to VITE_API_URL + /login.
VITE_LOGIN_URL=http://localhost:3000/login
