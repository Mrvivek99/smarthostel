# ---- Core ----
# MongoDB Atlas connection string (a replica set / Atlas cluster is required for transactions;
# a standalone local mongod also works, the allocation engine then falls back to atomic ops + compensation)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/smarthostel?retryWrites=true&w=majority
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Public URL of this Next.js app (used in email links)
APP_URL=http://localhost:3000
# Origin(s) of the admin SPA allowed by CORS (comma separated). Cookies are sent with credentials.
ADMIN_ORIGIN=http://localhost:5173
# Where admins/super-admins are sent after logging in on the Next.js login page
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173
# Optional: lax | strict | none. Default: lax in dev, none (+Secure) in production when ADMIN_ORIGIN is set.
COOKIE_SAMESITE=
# Timezone used for "today" in attendance
APP_TIMEZONE=Asia/Kolkata

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ---- Cloudinary (signed uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (optional; without SMTP, links are logged to the server console in development) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SmartHostel <no-reply@smarthostel.local>"
CONTACT_EMAIL=support@smarthostel.local
